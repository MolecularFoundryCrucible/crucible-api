DB_USERNAME=crucible-api-user
DB_SERVER=127.0.0.1:5432
DB_DATABASE=crucible
PGDB_PW=<SECRET>
API_PUBLIC_URL=http://127.0.0.1:7777
API_PATH=testapi
CRUCIBLE_SECRET_KEY=<SECRET of at least 32 characters, for example from: openssl rand -hex 32>
CRUCIBLE_CURSOR_SIGNING_KEYS={"v1":"<SECRET>"}
CRUCIBLE_CURSOR_ACTIVE_KEY_ID=v1

# File storage (gcs or s3). Without UPLOAD_BUCKET, file routes answer 501.
STORAGE_BACKEND=gcs
# UPLOAD_BUCKET=<BUCKET>

# Optional features, off by default.
# INGESTION_ENABLED=true
# RMQ_HOST=localhost
# RMQ_PORT=5672
# RMQ_USER=admin
# PRINTING_ENABLED=true
# PROPOSAL_SYNC_ENABLED=true

# Secrets for the optional features. Each secret can also be a file named NAME in the
# secrets directory (CRUCIBLE_SECRETS_DIR, default /run/secrets), or
# NAME_VERSION=projects/<project>/secrets/<secret>/versions/<n>.
# RABBITMQ_DEFAULT_PW=<SECRET>
# MQTT_PASSWORD=<SECRET>
# PROPDB_APIKEY=<SECRET>
